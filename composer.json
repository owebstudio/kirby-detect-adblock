{
  "name": "owebstudio/kirby-detect-adblock",
  "description": "Detects ad blockers and shows your visitors a warning in a modal dialog or a banner.",
  "version": "1.0.2",
  "type": "kirby-plugin",
  "license": "MIT",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby-plugin",
    "adblock",
    "detect-adblocker"
  ],
  "homepage": "https://github.com/owebstudio/kirby-detect-adblock",
  "support": {
    "issues": "https://github.com/owebstudio/kirby-detect-adblock/issues",
    "source": "https://github.com/owebstudio/kirby-detect-adblock"
  },
  "authors": [
    {
      "name": "oweb studio",
      "homepage": "https://github.com/owebstudio"
    }
  ],
  "require": {
    "php": "^8.2",
    "getkirby/composer-installer": "^1.2"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "installer-name": "kirby-detect-adblock",
    "kirby": {
      "compatible": "^5.0 || ^6.0"
    }
  }
}
